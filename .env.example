# EcoScan AI Environment Configuration
# API Gateway origin from the template.yaml ApiUrl output (no trailing slash).
# This is a public endpoint, never an AWS credential or model API key.
# If blank, uploads fall back to clearly labelled illustrative demo data.
VITE_API_URL=

# Server only. Never prefix these secrets with VITE_.
GEMINI_API_KEY=
# Optional authorized backup, tried on provider 429 only. Keys on the same
# Google project share quota; a second key does not increase that quota.
# Exhausted keys cool down using Retry-After (default 60 seconds) per server instance.
GEMINI_API_KEY_BACKUP=
# Gemini 1.5 Flash is no longer current; use a supported vision model.
GEMINI_MODEL=gemini-3.7-flash
# Required for remote API key management; optional on direct localhost.
# Set a long, random operator secret; enter it in the Hub for this session only.
ECO_ADMIN_SECRET=
